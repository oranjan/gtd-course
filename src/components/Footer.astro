---
import Default from '@astrojs/starlight/components/Footer.astro';
---

<Default />
<p class="storage-note">
	Your notes and progress are saved only in this browser on this device. Keep using the same device
	and browser to keep your data. Clearing browsing data will erase it.
</p>

<style>
	.storage-note {
		margin-top: 2rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
		text-align: center;
	}
</style>
